<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件统一卡片：深色渐变 + 细描边 + 圆角 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#232B40"
        android:endColor="#141926"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#2E3850" />
</shape>