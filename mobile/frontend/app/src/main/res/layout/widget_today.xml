<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2「今日日程」：头部日期 + 最多 4 条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_today_label"
            android:textColor="#F2F5FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_today_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#8E99B3"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:background="#26304A" />

    <LinearLayout
        android:id="@+id/widget_today_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_today_t1"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#7C9CFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_today_n1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8EDF7"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_today_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_today_t2" android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#A88CFF" android:textSize="11sp" />
        <TextView android:id="@+id/widget_today_n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E8EDF7" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_today_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_today_t3" android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#5BD6A0" android:textSize="11sp" />
        <TextView android:id="@+id/widget_today_n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E8EDF7" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_today_row4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_today_t4" android:layout_width="52dp" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#F0B45A" android:textSize="11sp" />
        <TextView android:id="@+id/widget_today_n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#E8EDF7" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>