# 统一换行符，避免跨平台 diff 噪音
* text=auto

# 源码与文档统一 LF
*.java   text eol=lf
*.xml    text eol=lf
*.html   text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.pro    text eol=lf
gradlew  text eol=lf

# Windows 批处理保持 CRLF
*.bat    text eol=crlf

# 二进制
*.jar      binary
*.jks      binary
*.keystore binary
*.png      binary
*.apk      binary
